<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="bh_quick_sticky_notes.FormView" t-inherit="web.FormView" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_form_view_container')]" position="inside">
            <StickyNotesPanel
                t-if="!env.inDialog and model.root.resId"
                resModel="model.root.resModel"
                resId="model.root.resId"
            />
        </xpath>
    </t>
</templates>
